#!/usr/bin/env sh
#
# DB를 커밋하기 전에 WAL을 본체 파일로 접어 넣는다.
#
# 왜: prisma/meta.db·data/app.db는 WAL 모드라 새로 쓴 내용이 한동안 `*.db-wal`에만 있다.
# 그 파일은 커밋하지 않으므로(다른 PC에서 열 때 어긋난다), 그냥 커밋하면 **본체만 올라가고
# 최근 변경은 통째로 빠진다**. 게다가 `git status`는 본체가 안 바뀌었으니 깨끗하다고 하고,
# 이 PC에서는 WAL을 함께 읽어 멀쩡히 보인다 — clone한 사람만 예전 화면을 본다.
# 실제로 리비전 #80이 그렇게 누락됐다(2026-08-31).
#
# 켜기: pnpm setup:local  (git config core.hooksPath .githooks 를 대신 해 준다)
set -e

staged="$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.db$' || true)"
[ -n "$staged" ] || exit 0

if ! pnpm db:checkpoint; then
  echo ''
  echo '커밋을 멈췄습니다 — DB의 WAL을 본체에 접어 넣지 못했습니다.'
  echo '그대로 커밋하면 최근 변경이 빠진 DB가 올라갑니다. 아래를 실행한 뒤 다시 커밋하세요:'
  echo '  pnpm db:checkpoint && git add prisma/meta.db data/app.db'
  exit 1
fi

# 접어 넣으면서 본체 파일이 바뀌었을 수 있으니 다시 담는다.
echo "$staged" | while IFS= read -r f; do
  [ -n "$f" ] && [ -f "$f" ] && git add -- "$f"
done
