{
  "name": "webapp-scaffold",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm theme:gen && next dev --turbopack",
    "build": "pnpm theme:gen && next build --turbopack",
    "analyze": "node scripts/analyze.mjs",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:init": "tsx src/lib/db/init-app-db.ts",
    "db:backup": "tsx scripts/backup-db.ts",
    "db:seed": "prisma db seed",
    "shadcn:sync": "tsx scripts/shadcn-sync.ts",
    "registry:gen-meta": "tsx scripts/generate-node-meta.ts",
    "audit:catalog": "tsx --tsconfig scripts/audit.tsconfig.json scripts/audit-catalog.tsx",
    "theme:gen": "tsx scripts/generate-theme-css.ts",
    "audit:ui": "node scripts/audit-ui.mjs",
    "db:optimize": "tsx scripts/optimize-indexes.ts",
    "validate": "tsx scripts/validate-draft.mts",
    "audit:wiring": "tsx scripts/audit-wiring.mts",
    "verify:actions": "node scripts/verify-actions.mjs",
    "verify:screens": "node scripts/verify-screens.mjs",
    "setup:local": "node scripts/setup-local.mjs",
    "admin:password": "node scripts/set-admin-password.mjs",
    "db:sync-schema": "tsx scripts/sync-schema.mts",
    "deploy:draft": "tsx scripts/deploy-draft.mts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.9.0",
    "@prisma/client": "^6.19.3",
    "@shadcn/react": "^0.3.0",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.9",
    "@xyflow/react": "^12.11.3",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dagre": "^0.8.5",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "iron-session": "^8.0.4",
    "lucide-react": "^1.31.0",
    "nanoid": "^6.0.1",
    "next": "15.5.23",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.1.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.3",
    "recharts": "3.8.0",
    "shadcn": "^4.18.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.4.3",
    "zundo": "^2.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@next/bundle-analyzer": "^15.5.23",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/dagre": "^0.7.54",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9",
    "eslint-config-next": "15.5.23",
    "prettier": "^3.9.6",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
