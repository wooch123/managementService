# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-dev/
/.next-a/
/.next-b/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright
/test-results/
/playwright-report/
/blob-report/

# WebApp_V1: operational data + meta db (never commit business data)
/data/
/prisma/meta.db
/prisma/meta.db-journal
/prisma/meta.db-wal
/prisma/meta.db-shm
/data/action.log

# WebApp_V1: E2E 전용 DB (매 실행 재생성)
/prisma/test-meta.db
/prisma/test-meta.db-wal
/prisma/test-meta.db-shm
