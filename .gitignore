# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-dev/
/.next-a/
/.next-b/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright
/test-results/
/playwright-report/
/blob-report/

# 배포 인프라는 올리지 않는다 — 이 저장소는 **로컬에서 돌리는 것**만 담는다.
# 도메인·터널 설정·프로세스 관리자·자동 기동 등록은 이 PC에만 있는 운영 사정이고,
# 받는 사람에게는 쓸모가 없을뿐더러 호스트 이름과 경로가 그대로 공개된다.
# (로컬에는 그대로 남아 있다 — git이 추적만 하지 않는다.)
/deploy/

# WebApp_V1: 설계·운영 데이터는 **함께 올린다** — 다른 PC에서 받아 바로 같은 화면을 보기 위해서다.
#   포함: prisma/meta.db(설계·리비전·게시판) · data/app.db(업무 데이터) · data/uploads(첨부 이미지)
#   제외: 아래처럼 실행 중 생기거나 계속 커지는 것들.
# SQLite가 실행 중에 만드는 임시 파일 — 커밋하면 다른 PC에서 DB를 열 때 어긋난다(본체에 체크포인트해 둔다).
*.db-wal
*.db-shm
*.db-journal
# 매 실행 재생성되는 E2E 전용 DB
/prisma/test-meta.db
/data/test-app.db
# 계속 쌓이는 것들
/data/backups/
/data/logs/
/data/action.log


# 작업 중 만드는 임시 스크립트·추출물
/.tmpq/
/.tmp-*
