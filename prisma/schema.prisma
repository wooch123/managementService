datasource db {
  provider = "sqlite"
  url      = "file:./meta.db"
}

generator client {
  provider = "prisma-client-js"
}

// ── 인증 ──
model AdminUser {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ── 페이지 (드래프트) ──
model Page {
  id         String          @id @default(cuid())
  slug       String          @unique
  title      String
  icon       String?
  parentId   String?
  parent     Page?           @relation("PageTree", fields: [parentId], references: [id])
  children   Page[]          @relation("PageTree")
  order      Int
  isVisible  Boolean         @default(true)
  isHome     Boolean         @default(false)
  /// 운영 화면(/home)에서 우측 플로팅 패널(region="aside")을 표시할지 — 관리자가 페이지 속성에서 끈다.
  /// 끄면 패널에 컴포넌트가 있어도 렌더하지 않고 본문이 그 폭까지 넓게 쓴다.
  asideVisible Boolean       @default(true)
  layoutCols Int             @default(12)
  rowHeight  Int             @default(8)
  gap        Int             @default(16)
  nodes      ComponentNode[]
  graphNode  GraphNode?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([parentId, order])
}

// ── 컴포넌트 인스턴스 (드래프트) ──
model ComponentNode {
  id           String          @id @default(cuid())
  pageId       String
  page         Page            @relation(fields: [pageId], references: [id], onDelete: Cascade)
  type         String
  parentNodeId String?
  parentNode   ComponentNode?  @relation("NodeTree", fields: [parentNodeId], references: [id])
  childNodes   ComponentNode[] @relation("NodeTree")
  order        Int
  gridCol      Int             @default(1)
  gridSpan     Int             @default(12)
  gridRow      Int             @default(1)
  gridRowSpan  Int             @default(4)
  /// 이 컴포넌트가 놓인 화면 영역 — "main"(본문 그리드) | "aside"(우측 플로팅 패널).
  /// 두 영역 모두 같은 12칼럼 그리드 규칙을 쓰고, 관리자 캔버스에서 영역을 전환해 편집한다.
  region       String          @default("main")
  propsJson    String          @default("{}")
  bindingJson  String?
  eventsJson   String          @default("{}")
  label        String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([pageId, parentNodeId, order])
}

// ── 데이터 설계 ──
model Entity {
  id          String   @id @default(cuid())
  name        String   @unique
  tableName   String   @unique
  description String?
  fields      Field[]
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Field {
  id          String  @id @default(cuid())
  entityId    String
  entity      Entity  @relation(fields: [entityId], references: [id], onDelete: Cascade)
  name        String
  columnName  String
  dataType    String
  isRequired  Boolean @default(false)
  isUnique    Boolean @default(false)
  isPrimary   Boolean @default(false)
  defaultVal  String?
  enumValues  String?
  refEntityId String?
  order       Int

  @@unique([entityId, columnName])
  @@index([entityId, order])
}

// ── 관계 (관계도의 연결선) ──
model Relation {
  id          String   @id @default(cuid())
  fromType    String
  fromId      String
  toType      String
  toId        String
  kind        String
  cardinality String?
  labelText   String?
  metaJson    String   @default("{}")
  createdAt   DateTime @default(now())

  @@unique([fromType, fromId, toType, toId, kind])
}

// ── 동작 정의 ──
model Action {
  id          String    @id @default(cuid())
  name        String    @unique
  kind        String
  configJson  String    @default("{}")
  description String?
  graphNode   GraphNode?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// ── 관계도 노드 좌표 ──
model GraphNode {
  id       String  @id @default(cuid())
  refType  String
  refId    String  @unique
  x        Int
  y        Int
  width    Int     @default(220)
  height   Int     @default(120)
  isPinned Boolean @default(false)
  pageId   String? @unique
  page     Page?   @relation(fields: [pageId], references: [id], onDelete: Cascade)
  actionId String? @unique
  action   Action? @relation(fields: [actionId], references: [id], onDelete: Cascade)
}

/// 관계도 "보기 범위"별 노드 좌표. GraphNode(전체 구조 보기)와 별개로, 페이지별 보기에서
/// 정렬한 배치를 그 페이지 전용으로 기억한다 — 페이지 A를 정렬한 뒤 B를 정렬해도 A로 돌아오면
/// A의 배치가 그대로 남아야 하고, 전체 구조 보기도 영향을 받으면 안 되기 때문이다.
/// viewKey에 저장된 좌표가 없으면 GraphNode(전체 보기) 좌표로 자연스럽게 폴백한다.
model GraphViewPosition {
  id        String   @id @default(cuid())
  /// 보기 범위 식별자 — 지금은 Page.id를 쓴다("전체 구조"는 GraphNode에 저장하므로 여기 없음)
  viewKey   String
  refType   String
  refId     String
  x         Int
  y         Int
  updatedAt DateTime @updatedAt

  @@unique([viewKey, refType, refId])
  @@index([viewKey])
}

/// 사이트 전역 설정(단일 행) — 사이드바 상단에 보이는 이름/부제처럼 페이지 설계가 아닌
/// "앱 자체"의 표시 정보를 담는다. 관리자가 관리자 화면에서 직접 수정한다.
model AppSetting {
  id           String   @id @default("singleton")
  siteTitle    String   @default("WebApp_V1")
  siteSubtitle String   @default("v1.0.1")
  updatedAt    DateTime @updatedAt
}

// ── 배포 ──
model Revision {
  id           String   @id @default(cuid())
  revisionNo   Int      @unique
  specJson     String
  migrationSql String?
  note         String?
  publishedAt  DateTime @default(now())
  publishedBy  String
}

model Deployment {
  id               String   @id @default("singleton")
  activeRevisionId String?
  updatedAt        DateTime @updatedAt
}

/// 운영 사이트 방문자 간 실시간 채팅 메시지. 관리자가 설계하는 데이터(app.db)가 아니라
/// 플랫폼이 제공하는 기능의 저장소라 메타 DB에 둔다(스키마는 마이그레이션으로만 바뀐다).
model ChatMessage {
  id        String   @id @default(cuid())
  /// 채팅방 키 — 컴포넌트 속성으로 지정한다(한 사이트에서 여러 방 운영 가능)
  room      String
  author    String
  body      String
  createdAt DateTime @default(now())

  @@index([room, createdAt])
}

// ── 검증 결과 캐시 ──
model ValidationRun {
  id         String    @id @default(cuid())
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  errorCount Int       @default(0)
  warnCount  Int       @default(0)
  resultJson String    @default("[]")
  specHash   String
}

// ── 게시판 (플랫폼 제공 기능) ──
/// 관리자가 layout 구성에서 '게시판'을 배치하면 즉시 동작한다. 동적 DDL(app.db) 대신 메타 DB에
/// 고정 스키마로 둔 이유: 배치와 동시에 활성화되려면 테이블이 이미 존재해야 하기 때문이다.
/// 실시간 채팅(ChatMessage)과 같은 방식이다.
model BoardPost {
  id        String   @id @default(cuid())
  /// 게시판 키 — 기본값은 배치된 컴포넌트 노드 id다(배치할 때마다 독립된 게시판이 생긴다).
  /// 속성에서 직접 지정하면 여러 페이지가 같은 게시판을 공유할 수 있다.
  boardKey  String
  category  String?
  /// 채팅형으로 바뀐 뒤 새 메시지는 제목이 없다(빈 문자열). 예전 글은 제목을 그대로 두고
  /// 말풍선 첫 줄에 굵게 보여준다 — 2,001건의 기존 글을 버리지 않기 위한 선택이다.
  title     String
  content   String
  author    String
  viewCount Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attachments BoardAttachment[]

  @@index([boardKey, createdAt])
}

/// 게시판 메시지에 붙는 이미지.
///
/// 파일 자체는 `data/uploads/board/` 아래에 두고 여기에는 메타만 둔다 — 이미지 바이트를 SQLite에
/// 넣으면 DB가 급격히 커지고 WAL·일별 백업이 함께 무거워진다. 보내기 전에 먼저 업로드하므로
/// `postId`는 잠시 비어 있을 수 있고(붙여넣자마자 업로드 → 전송할 때 연결), 끝내 연결되지 않은
/// 것은 나중에 청소한다.
model BoardAttachment {
  id        String     @id @default(cuid())
  postId    String?
  post      BoardPost? @relation(fields: [postId], references: [id], onDelete: Cascade)
  /// 갤러리가 게시판 단위로 훑을 때 조인 없이 읽기 위해 함께 둔다.
  boardKey  String
  /// 디스크에 저장된 이름 — **서버가 만든다**(업로드한 파일명은 경로 조작에 쓰일 수 있어 쓰지 않는다).
  fileName  String
  /// 표시용 원본 이름(내려받기 파일명에만 쓴다).
  origName  String
  mimeType  String
  byteSize  Int
  width     Int?
  height    Int?
  /// 한 메시지 안에서의 순서. 여러 장을 **동시에** 올리므로 업로드가 끝난 순서(createdAt)는
  /// 사용자가 붙여넣은 순서와 다르다 — 보낼 때 받은 목록 순서를 여기에 적어 그대로 보여준다.
  sortOrder Int        @default(0)
  createdAt DateTime   @default(now())

  @@index([boardKey, createdAt])
  @@index([postId])
}
